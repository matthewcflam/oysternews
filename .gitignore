node_modules/
.next/
out/

# Phase 2.5: the downloaded GKG bundle (4-6 MB) and the GeoJSON generated from
# it. `npm run gkg` re-creates both; bundles are immutable, so the cache is only
# ever re-read, never invalidated. Phase 3 commits ONE real bundle under
# fixtures/ as the §7 test fixture — that one is a fixture, not this cache.
.cache/
build/
.vercel/
.env
.env.local
*.tsbuildinfo
next-env.d.ts

# Phase 3G: no archive is committed any more. Phase 2's fake archive was, on the
# reasoning that Vercel has no tippecanoe and an ignored archive would ship a map
# with zero pins. That reasoning ended when the browser started reading
# manifest.json — the archive is published to Blob by the worker, not built at
# deploy time, so a committed one can only go stale and mislead.
# `npm run tiles:fake` still writes here for local work; keep it out of the repo.
*.pmtiles

# The one exception, and the reason the rule above is about staleness rather
# than about file type: boundaries.pmtiles is STATIC (§3.1). It is built once
# from Natural Earth by `npm run boundaries`, changes only when Natural Earth
# does, and Vercel has no tippecanoe to rebuild it at deploy time. Committing it
# is what makes the §2.2 red outline work in production.
!public/boundaries.pmtiles

# Copied out of node_modules by predev/prebuild so MapLibre's worker is a real
# static asset (scripts/copy-maplibre-worker.mjs). Versioned with the package,
# so committing them would just go stale.
public/maplibre-gl-worker.mjs
public/maplibre-gl-shared.mjs
.gstack/
