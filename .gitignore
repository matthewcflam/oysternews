node_modules/
.next/
out/

# Phase 2.5: the downloaded GKG bundle (4-6 MB) and the GeoJSON generated from
# it. `npm run gkg` re-creates both; bundles are immutable, so the cache is only
# ever re-read, never invalidated. Phase 3 commits ONE real bundle under
# fixtures/ as the §7 test fixture — that one is a fixture, not this cache.
.cache/
build/
.vercel/
.env
.env.local
*.tsbuildinfo
next-env.d.ts

# Phase 2's fake archive IS committed, deliberately and temporarily. It is a build
# artifact (`npm run tiles:fake`), but Vercel has no tippecanoe and cannot generate
# it, so leaving it ignored ships a live map with zero pins — which is the whole
# point of the phase. 21 KB, and `.gitattributes` marks *.pmtiles binary so the
# Windows CRLF filter cannot corrupt it.
# Phase 3 deletes it from the repo: publish.ts writes the real archive to Vercel
# Blob, and that one is never committed.

# Copied out of node_modules by predev/prebuild so MapLibre's worker is a real
# static asset (scripts/copy-maplibre-worker.mjs). Versioned with the package,
# so committing them would just go stale.
public/maplibre-gl-worker.mjs
public/maplibre-gl-shared.mjs
.gstack/
