{
  "name": "sonder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "gkg": "node scripts/build-real-geojson.ts",
    "tiles:fake": "bash scripts/build-tiles.sh fixtures/fake-stories.geojson sonder-stories-fake",
    "tiles:real": "bash scripts/build-tiles.sh build/stories.geojson sonder-stories"
  },
  "dependencies": {
    "maplibre-gl": "^6.2.0",
    "next": "^16.3.0",
    "pmtiles": "^4.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2"
  }
}
